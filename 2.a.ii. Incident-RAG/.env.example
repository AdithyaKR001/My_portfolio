# ---- Default: fully local via Ollama (no API key) ----
# Requires:  ollama pull llama3.1  &&  ollama pull nomic-embed-text
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

EMBED_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text

# Retrieval knobs
TOP_K=4
CHUNK_SIZE=600
CHUNK_OVERLAP=80
RERANK=1

# ---- Optional: OpenAI instead (comment out the Ollama lines above) ----
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini
# EMBED_PROVIDER=openai
# OPENAI_EMBED_MODEL=text-embedding-3-small
