# --- Backend selection ---
# mock   = deterministic, dependency-free local embedder (default; simulates model latency)
# ollama = calls a real local Ollama embedding model
BACKEND=mock

# --- Ollama backend (only used when BACKEND=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text

# --- Mock backend tuning (simulated inference cost) ---
MOCK_BASE_LATENCY_MS=8
MOCK_PER_ITEM_LATENCY_MS=6
MOCK_EMBED_DIM=64

# --- Dynamic batching ---
# Requests arriving within BATCH_MAX_WAIT_MS of each other (up to BATCH_MAX_SIZE)
# are coalesced into a single backend call.
BATCH_MAX_SIZE=16
BATCH_MAX_WAIT_MS=20

# --- Cache (LRU + TTL) ---
CACHE_MAX_SIZE=2000
CACHE_TTL_SECONDS=300
