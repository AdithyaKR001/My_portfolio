# ---- Option A: Ollama (default; fully local, no API key) ----
# Install Ollama (https://ollama.com), then:  ollama pull llama3.1
# The model must support tool calling (llama3.1, qwen2.5, mistral-nemo, ...).
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# ---- Option B: OpenAI (needs an API key; comment out Option A above) ----
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# Only used by the FastAPI server: auto-approve write actions (demo only)
# AUTO_CONFIRM_WRITES=0

# Only used by the FastAPI server: comma-separated origins allowed to call /chat
# from a browser (e.g. a chat widget embedded in another web app). Defaults to "*"
# for local demo use — set this to your host app's real origin(s) before deploying.
# CORS_ALLOWED_ORIGINS=https://your-host-app.example.com
